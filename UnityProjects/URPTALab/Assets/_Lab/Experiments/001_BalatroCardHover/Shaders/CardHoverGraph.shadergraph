{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "87f58f0f711c48fb8d77f34c8334b748",
    "m_Title": "04 / Clip position to object position",
    "m_Content": "Shader Graph Position accepts float3 object space.\nC = VP * float4(positionWS, 1); C.w = max(C.w + deltaW, 0.2)\nQ = inverseVP * C; positionWS = Q.xyz / Q.w\nThis preserves projected XYZ, but requires UV correction below.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 0.0,
        "y": 650.0,
        "width": 410.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": "62757aadbb4d4823b979361db8c09232"
    }
}

